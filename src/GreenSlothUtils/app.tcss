Screen {
    align: center middle;
}

DataTable {
    /* ... your existing table rules ... */
    text-overflow: ellipsis; /* Appends ... to truncated cell text */
}

.head-row {
    margin-bottom: 1;
    text-style: bold;
}

.equal-width {
    width: 1fr
}

.equal-height {
    height: 1fr
}

.center-children {
    align-horizontal: center;
}

.title-compare {
    text-style: bold;
    text-align: center
}

#start-page {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 2;

    Button {
        width: 100%;
        height: 100%;
    }
}

#button-stepguide {
    column-span: 2;
}

#directory-label {
    width: 1fr;
}

#button-modelcreate {
    width: 1fr;
}

#input-modelname {
    width: 1.5fr;

    &.valid {
        background: $success;
    }

    &.invalid {
        background: $error;
    }
}

TabbedContent {
    align-horizontal: center;
}

.has-data {
    background: $error;
}

.has-no-data {
    background: $success;
}

.low-text {
    color: $text-disabled;
}

.hint-icon {
    min-width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: $text-muted;
}

.hint-icon:hover {
    color: $accent; /* Lights up when they hover */
}

Tooltip {
    background: $surface;
    color: $text;
    border: $accent;
}